# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
.turbo/
.vercel/
dist/
build/
out/
*.tsbuildinfo

# Environment — NEVER commit any populated env file.
# `.env.example` (committed) is the template; everything else stays out.
.env
.env.local
.env.*.local
.env.development.local
.env.production.local

# Inbox — secret drop zone (credentials handoff from user to Claude).
# NEVER let anything here land in git. Contains DB connection strings,
# API keys, OAuth secrets during integration sprints.
inbox/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage / test outputs
coverage/
.nyc_output/

# Eval outputs (regenerable)
eval/results/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Sentry
.sentryclirc

# Misc
*.tmp
